# -----------------------------------------------------------------------------
# LLM Course Final Project - Environment Configuration Template
# Copy this file to a new file named '.env' and fill in the values.
# Only ONE of the three options below needs to be configured.
# -----------------------------------------------------------------------------

# Option A: Azure OpenAI Service (v1 API)
# Uses the standard OpenAI client with base_url = {endpoint}/openai/v1/
# No api_version is needed with the v1 API.
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here  # Either something like https://YOUR-RESOURCE.openai.azure.com or https://REGION.api.cognitive.microsoft.com
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-nano

# Option B: Standard OpenAI API (or local OpenAI-compatible server like vLLM/Ollama) -> Use this if you use the api keys provided by the instructors, setting
OPENAI_API_KEY=your-key
OPENAI_MODEL_NAME=gpt-5-nano
# OPENAI_BASE_URL=http://localhost:8000/v1   # Uncomment for local servers
OPENAI_BASE_URL=dice-llm-url   # Uncomment for instructor-provided proxy server

# Option C: Local Hugging Face Model (loaded directly with transformers)
# LOCAL_MODEL_NAME=HuggingFaceTB/SmolLM2-135M-Instruct
# LOCAL_MODEL_NAME=HuggingFaceTB/SmolLM2-1.7B-Instruct
# LOCAL_MODEL_NAME=Qwen/Qwen3-4B

#HF_TOKEN=your-hf-token
